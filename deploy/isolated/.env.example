# 隔离环境凭据模板（入库）。
# 用法：cp deploy/isolated/.env.example deploy/isolated/.env 后填入真实随机值。
# deploy/isolated/.env 不入库（见 .gitignore：.env / .env.* / !.env.example）。
# 生成 32 字节 Base64 密钥示例：openssl rand -base64 32
#
# 预检（check --require-secrets）会拒绝 CHANGE_ME 之类的占位值，缺值或不满足长度时禁止启动。

HAITLIFY_ISOLATED_MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
HAITLIFY_ISOLATED_DB_PASSWORD=CHANGE_ME_DB_APP
# 必须是 32 字节 Base64（平台用它加密存储的第三方凭据）。
HAITLIFY_ISOLATED_SECRET_KEY=CHANGE_ME_32_BYTE_BASE64

# Hermes 执行单元基础镜像（你自己构建/拉取的 hermes-agent 镜像）。
# 仓库里不含 Hermes 源码，避免构建期静默拉一个会漂移的 tag。
HAITLIFY_ISOLATED_HERMES_IMAGE=haitlify-hermes:local
# 可选：覆盖容器内网关入口（默认 python3 -m tui_gateway.entry）。
# HAITLIFY_ISOLATED_HERMES_GATEWAY_CMD=python3 -m tui_gateway.entry
