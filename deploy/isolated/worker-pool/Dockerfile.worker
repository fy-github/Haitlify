# Template only. Supply a credential-free, audited image pinned by sha256.
# Do NOT build from an operator checkout or copy its .env/HOME/history.
ARG HERMES_BASE_IMAGE
FROM ${HERMES_BASE_IMAGE}
USER 0
COPY gate.py protocol.py edge.py worker.py runtime-manifest.json /opt/pool/
USER 10001:10001
ENV HOME=/home/worker HERMES_HOME=/home/worker/.hermes PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
ENTRYPOINT ["python3", "/opt/pool/worker.py"]
