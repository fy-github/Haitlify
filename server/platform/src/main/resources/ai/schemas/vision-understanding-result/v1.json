{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vision-understanding-result/v1",
  "type": "object",
  "required": ["elements"],
  "additionalProperties": false,
  "properties": {
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "label"],
        "additionalProperties": true,
        "properties": {
          "kind": {"type": "string", "enum": ["button", "input", "link", "text", "image", "container", "unknown"]},
          "label": {"type": "string", "maxLength": 500},
          "state": {"type": "string", "enum": ["enabled", "disabled", "hidden", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "pageSummary": {"type": "string", "maxLength": 2000}
  }
}
