{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "formal-web-cases/v1",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourcePointId", "title", "module", "caseKind", "pageName", "startUrl",
                     "browser", "viewport", "precondition", "steps", "assertions", "expectedResult",
                     "sourceFile", "sourceText"],
        "additionalProperties": true,
        "properties": {
          "sourcePointId": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "module": {"type": "string", "minLength": 1},
          "caseKind": {"type": "string", "enum": ["web_automation"]},
          "pageName": {"type": "string", "minLength": 1},
          "startUrl": {"type": "string", "minLength": 1},
          "browser": {"type": "string", "enum": ["chromium", "firefox", "webkit"]},
          "viewport": {"type": "string", "minLength": 1},
          "precondition": {"type": "string"},
          "steps": {"type": "string", "minLength": 1},
          "assertions": {"type": "string", "minLength": 1},
          "expectedResult": {"type": "string", "minLength": 1},
          "sourceFile": {"type": "string", "minLength": 1},
          "sourceText": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
